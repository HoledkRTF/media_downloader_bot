# Telegram Bot Token (obtained from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Comma-separated Telegram User IDs with admin privileges (for /logs command and administrative access)
ADMIN_USER_IDS=12345678,98765432

# Fallback passcode for administrative tools (e.g. /adminmisuse <passcode>)
ADMIN_PASSCODE=your_secret_admin_passcode

# Secret token required to view operational logs via HTTP endpoint GET /logs
# Pass as header 'X-Admin-Token: <token>' or query parameter '?token=<token>'
ADMIN_LOGS_TOKEN=your_secret_logs_token

# Secret token configured for Telegram Webhook validation (header: X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret

# External URL where this bot is hosted (used for setting Telegram webhook)
# E.g., https://your-service.onrender.com
RENDER_EXTERNAL_URL=https://your-service.onrender.com

# Port for the web server (defaults to 10000 on Render)
PORT=10000

# MongoDB Connection URI (Optional: if omitted, bot safely falls back to local atomic JSON persistence)
# E.g., mongodb+srv://<user>:<password>@cluster.mongodb.net/downloader?retryWrites=true&w=majority
MONGODB_URI=

# Instagram Session ID Cookie (Optional: bypasses Instagram login walls for reels/posts)
INSTAGRAM_SESSION_ID=

# Twitter Session Tokens (Optional: for authenticated Twitter scraping fallback)
TWITTER_AUTH_TOKEN=
TWITTER_CT0=

# Telethon User-Client Credentials (Optional: used for chat_sync.py and purge_chat.py)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
BOT_USERNAME=ThePervertedBrotherBot
